    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "next": "^15.5.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.12.4",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.1"
