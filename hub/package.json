{
  "name": "setnel-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Setnel Hub \u2014 central ingest + storage + private alert page for Datum Labs dashboards",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "db:push": "tsx db/push.ts && tsx db/migrate.ts",
